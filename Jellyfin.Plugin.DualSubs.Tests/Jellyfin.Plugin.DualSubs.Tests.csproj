  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.DualSubs\Jellyfin.Plugin.DualSubs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestData\**\*" CopyToOutputDirectory="PreserveNewest" />
